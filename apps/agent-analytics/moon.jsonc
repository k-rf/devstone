{
  "$schema": "../../.moon/cache/schemas/project.json",

  "id": "agent-analytics",
  "layer": "application",
  "language": "typescript",
  "toolchains": { "default": "node" },
  "tags": ["testable"],

  "project": {
    "title": "agent-analytics",
    "description": "トランスクリプト解析を用いてエージェントスキルの利用統計とサブリソース到達率を可視化するアプリケーションです。"
  },

  "tasks": {
    "test": {
      "command": "pnpm run test",
      "outputs": ["coverage/**"]
    }
  }
}
