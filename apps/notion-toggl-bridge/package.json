{
  "name": "@devstone/notion-toggl-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "NotionとToggl Trackを連携するCloudflare Workersアプリケーション。",
  "type": "module",
  "scripts": {
    "dev": "op run -- wrangler dev",
    "deploy": "op run -- wrangler deploy",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint --fix --max-warnings 0",
    "test": "vitest run",
    "wrangler": "op run --no-masking -- wrangler"
  },
  "dependencies": {
    "@hono/effect-validator": "1.2.0",
    "effect": "3.21.2",
    "hono": "4.12.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.15.1",
    "@cloudflare/workers-types": "4.20260430.1",
    "@devstone/configs-eslint": "workspace:*",
    "@devstone/configs-typescript": "workspace:*",
    "@devstone/configs-vitest": "workspace:*",
    "@faker-js/faker": "10.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "4.1.5",
    "eslint": "10.2.1",
    "msw": "2.14.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.5",
    "wrangler": "4.86.0"
  }
}
