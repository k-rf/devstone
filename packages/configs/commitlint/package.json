{
  "name": "@devstone/configs-commitlint",
  "version": "1.0.0",
  "private": true,
  "description": "commitlintの設定をまとめたパッケージです。",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint --fix --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "3.21.2"
  },
  "devDependencies": {
    "@commitlint/lint": "21.2.0",
    "@commitlint/parse": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@devstone/configs-eslint": "workspace:*",
    "@devstone/configs-typescript": "workspace:*",
    "@devstone/configs-vitest": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "commitlint": "21.0.2",
    "cz-customizable": "7.5.4",
    "eslint": "10.2.1",
    "typescript": "7.0.2",
    "vitest": "4.1.5"
  }
}
