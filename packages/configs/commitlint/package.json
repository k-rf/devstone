{
  "name": "@devstone/configs-commitlint",
  "version": "1.0.0",
  "private": true,
  "description": "commitlintの設定をまとめたパッケージです。",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint --fix --max-warnings 0"
  },
  "dependencies": {
    "effect": "3.21.2"
  },
  "devDependencies": {
    "@commitlint/types": "21.0.1",
    "commitlint": "21.0.2",
    "cz-customizable": "7.5.4",
    "eslint": "10.2.1",
    "typescript": "7.0.2"
  }
}
